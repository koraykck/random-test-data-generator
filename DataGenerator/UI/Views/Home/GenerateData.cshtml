@using UI.Models.Home
@model DisplayModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="d-flex justify-content-end">
    <a asp-action="DownloadAsCSV" asp-controller="Home" class="btn btn-sm btn-dark me-3">Download as CSV</a>
    <a asp-action="DownloadAsSQLScript" asp-controller="Home" class="btn btn-sm btn-dark me-3">Download as SQL Script</a>
    <a asp-action="DownloadAsJSON" asp-controller="Home" class="btn btn-sm btn-dark">Download as JSON</a>

</div>
<hr>
<table class="table table-hover">
    <thead>
        <tr>
            @foreach (var fieldName in Model.FieldNames)
            {
                <th >@fieldName</th>

            }            
        </tr>
    </thead>
    <tbody> 

        @foreach (var row in Model.Values)
        {
            <tr>
            @foreach (var fieldName in Model.FieldNames)
            {
                <td>@row[fieldName]</td>

            }
            </tr>

        }

    </tbody>
</table>